{
  "compilerOptions": {
    // Modern JavaScript and Node.js ESM behavior shared by every workspace project.
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Strict project-code checks that expose unsafe assumptions early.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Build metadata used by tsdown for the publishable library.
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // Keep source files compatible with independent ESM transforms.
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // Check this project's code without rechecking dependencies' declaration internals.
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
